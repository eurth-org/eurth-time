---
// The timeline, and under it what search engines and newcomers both want: what it is, how to
// use it, and answers to the usual questions (also given to search engines as structured data).
import { faqPage, launchedTools, webApplication } from '@eurth/style/build';
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import Timeline from '../tool/Timeline.svelte';

// What this site says about another tool is decided here, when it is built: the calendar maker
// is named only once its own door has opened.
const calendarMaker = launchedTools().find((tool) => tool.id === 'cal')?.url ?? null;

const faq = [
  { q: 'Is Time free?', a: 'Yes. There is no account, no watermark and no paid tier. It is made by the Eurth worldbuilding community for anyone who needs it.' },
  {
    q: 'Where is my timeline saved?',
    a: 'In its link. The link holds the whole timeline, so copying the link is saving it. A long history outgrows a link; save that as a profile file, which holds all of it and opens here again. Nothing is kept in your browser or on a server.',
  },
  {
    q: 'Can I date things in my own calendar?',
    a: 'Yes. Load a nation profile that has a calendar in it and the timeline is dated in that calendar: its months, its eras, its days outside the months. Without one, Time uses the Gregorian calendar.',
  },
  {
    q: 'What if I only know roughly when something happened?',
    a: 'Say so. Type "c. 1650" for about 1650, "1650s" for some time in that decade, or "17th century". Time draws such a date with a hollow marker or a dashed end, and says "c." wherever it writes it.',
  },
  { q: 'How far back can it go?', a: 'Further than you need. The axis zooms from single days out to thousands of millions of years.' },
  { q: 'Does it work offline, and on a phone?', a: 'Yes to both. After the first visit the site keeps a copy of itself on your device and opens without a connection.' },
];
---

<Page
  site={site}
  jsonld={[
    webApplication(site, {
      featureList: ['Tracks for nations, dynasties and a shared world', 'Dates in your own calendar', 'Uncertain dates', 'Zoom from millennia to days', 'Link that holds the timeline', 'SVG, PNG, CSV and wiki table exports', 'Nation profile file'],
    }),
    faqPage(faq),
  ]}
>
  <div class="eu-stack">
    <header class="eu-stack intro">
      <p class="eu-kicker">Time, by Eurth</p>
      <h1>A history timeline for your world</h1>
      <p class="eu-lead">Put nations, dynasties and the wider world side by side, and see what was happening at the same time. Free, in your browser, no account needed.</p>
    </header>

    <!-- client:load draws the timeline as real HTML first, then wakes it up. -->
    <Timeline client:load siteName={site.name} siteUrl={site.url} calendarMaker={calendarMaker} />

    <section class="eu-prose">
      <h2>How it works</h2>
      <ol>
        <li>Add a track for each thing whose story you are telling: a nation, a ruling house, the world they share.</li>
        <li>Add spans for what lasted (a reign, a war, the life of a state) and events for what happened on a date. Type dates as you would write them.</li>
        <li>Drag to slide through time, and zoom with the buttons, with a pinch, or with Ctrl and the wheel. The labels on the axis come and go as they find room.</li>
        <li>Choose anything to read its card, change it or link it to a forum thread or a wiki page.</li>
        <li>Copy the link, download the picture, or take the history to your wiki as a table.</li>
      </ol>
      <p>
        Not sure what to put on it? The <a href="/guide/">guide</a> explains how to build a history that convinces, the <a href="/glossary/">glossary</a> has the words, and there are{' '}
        <a href="/examples/">examples</a> to start from.
      </p>

      <h2>Questions</h2>
      <dl>
        {
          faq.map((item) => (
            <>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </div>

  <Fragment slot="inspirations">Time owes its layout to Joseph Priestley, who drew lives as bars along a line of years in 1765.</Fragment>
</Page>

<style>
  .intro {
    gap: var(--space-2);
  }
</style>
