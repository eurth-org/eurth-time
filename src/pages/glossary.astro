---
// The glossary: each term has an id to link to, and the whole set is given to search engines
// as a DefinedTermSet.
import { definedTermSet } from '@eurth/style/build';
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import { GLOSSARY_DESCRIPTION, GLOSSARY_TITLE, TERMS } from '../content/glossary';
---

<Page
  site={site}
  title={GLOSSARY_TITLE}
  description={GLOSSARY_DESCRIPTION}
  crumbs={[{ name: 'Glossary', path: '/glossary/' }]}
  jsonld={[definedTermSet(site, { name: GLOSSARY_TITLE, path: '/glossary/', terms: [...TERMS] })]}
>
  <article class="eu-prose">
    <p class="eu-kicker">Glossary</p>
    <h1>{GLOSSARY_TITLE}</h1>
    <p class="eu-lead">
      The words Time uses, and the ones historians use for the same things, in a sentence or two each. See the <a href="/guide/">guide</a> for how they fit together, or go straight to
      the <a href="/">timeline</a>.
    </p>
    <dl>
      {
        TERMS.map((term) => (
          <>
            <dt id={term.id} lang={term.id === 'longue-duree' ? 'fr' : term.id.startsWith('terminus') || term.id === 'floruit' || term.id === 'circa' ? 'la' : undefined}>
              {term.term}
            </dt>
            <dd>{term.definition}</dd>
          </>
        ))
      }
    </dl>
  </article>
</Page>
